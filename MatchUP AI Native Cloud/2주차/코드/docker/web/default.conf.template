# web 계층 nginx 설정 (기동 시 ${API_UPSTREAM} 가 환경변수로 치환된다)
server {
  listen 80;
  charset utf-8;
  root /usr/share/nginx/html;

  # 홈페이지 (상태 화면)
  location / { try_files $uri /index.html; }

  # [web 자체 상태] nginx 프로세스가 요청을 받아 응답할 수 있는가.
  # 업스트림(api/db)은 보지 않는다. 판단 근거를 JSON에 담아 돌려준다.
  #   $nginx_version : 실제 실행 중인 nginx 버전
  #   $hostname      : 응답한 파드 이름 (replica 2개 중 어느 쪽인지)
  #   $time_iso8601  : 응답 시각
  location = /healthz {
    default_type application/json;
    add_header Cache-Control no-store;
    return 200 '{"status":"ok","tier":"web","how":"nginx가 요청을 받아 직접 응답함(설정 로드·프로세스 생존). 업스트림(api/db)은 확인하지 않음 - 전 구간은 /healthz/chain","server":"nginx/$nginx_version","pod":"$hostname","time":"$time_iso8601"}';
  }

  # [전 구간] web -> api -> db. nginx가 api의 /healthz 를 호출해 그 응답(db 점검 결과 포함)을 그대로 전달한다.
  # api가 죽었으면 502/504, db가 막혔으면 api가 503을 돌려주고 그대로 전달된다.
  location = /healthz/chain {
    add_header Cache-Control no-store;
    proxy_pass ${API_UPSTREAM}/healthz;
    proxy_connect_timeout 3s;
    proxy_read_timeout 6s;
  }

  # api 프록시: /api/xxx -> api의 /xxx
  location /api/ {
    add_header Cache-Control no-store;
    proxy_pass ${API_UPSTREAM}/;
    proxy_connect_timeout 3s;
    proxy_read_timeout 6s;
  }
}
